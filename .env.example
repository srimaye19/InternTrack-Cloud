# ==========================================
# InternTrack-Cloud Configuration Template
# ==========================================

# Flask App Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-in-production-use-a-strong-random-secret
PORT=5000

# ------------------------------------------
# Database Configuration
# Options: 'sqlite' (local default) or 'mysql' (AWS RDS)
# ------------------------------------------
DB_TYPE=sqlite
SQLITE_DB_PATH=interntrack.db

# AWS RDS MySQL Settings (Leave empty for Phase 1 local development)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=interntrack_db

# ------------------------------------------
# File Storage Configuration
# Options: 'local' (local default) or 's3' (AWS S3)
# ------------------------------------------
STORAGE_TYPE=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5 MB max upload limit (in bytes)

# AWS S3 Settings (Leave empty for Phase 1 local development - S3 is disabled by default)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
# AWS credentials should NEVER be hardcoded. For EC2, an IAM role will be used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
